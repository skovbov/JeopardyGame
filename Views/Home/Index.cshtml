﻿@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jeopardy Spil</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #FF6B9D 0%, #C06C84 25%, #6C5B7B 50%, #355C7D 100%);
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* Animated music notes background */
        .music-note {
            position: absolute;
            font-size: 2em;
            opacity: 0.15;
            animation: float-notes 15s infinite ease-in-out;
        }

        .music-note:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
        .music-note:nth-child(2) { top: 30%; left: 80%; animation-delay: 3s; }
        .music-note:nth-child(3) { top: 70%; left: 20%; animation-delay: 6s; }
        .music-note:nth-child(4) { top: 50%; left: 60%; animation-delay: 9s; }
        .music-note:nth-child(5) { top: 80%; left: 70%; animation-delay: 12s; }

        @@keyframes float-notes {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            25% { transform: translateY(-30px) rotate(15deg); }
            50% { transform: translateY(-10px) rotate(-15deg); }
            75% { transform: translateY(-40px) rotate(10deg); }
        }

        .container {
            max-width: 1000px;
            width: 95%;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        .hidden {
            display: none !important;
        }

        /* Role Selection Screen */
        .role-selection {
            text-align: center;
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .title-container {
            margin-bottom: 50px;
        }

        h1 {
            font-size: 5em;
            font-weight: 900;
            text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.5);
            letter-spacing: 3px;
            margin-bottom: 10px;
            background: linear-gradient(45deg, #FFD700, #FF69B4, #00CED1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: pulse-glow 2s infinite;
        }

        @@keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.5)); }
            50% { filter: drop-shadow(0 0 25px rgba(255, 105, 180, 0.8)); }
        }

        .subtitle {
            font-size: 1.8em;
            margin-bottom: 20px;
            font-weight: 600;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .tagline {
            font-size: 1.2em;
            opacity: 0.9;
            font-style: italic;
        }

        /* Role Cards */
        .role-cards {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 40px;
            margin: 50px 0;
        }

        .role-card {
            background: rgba(255, 255, 255, 0.15);
            padding: 50px 30px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            backdrop-filter: blur(15px);
            border: 4px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .role-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 105, 180, 0.2));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .role-card:hover {
            transform: translateY(-15px) scale(1.08);
            border-color: #FFD700;
            box-shadow: 0 20px 60px rgba(255, 215, 0, 0.4);
        }

        .role-card:hover::before {
            opacity: 1;
        }

        .role-icon {
            font-size: 5em;
            margin-bottom: 20px;
            display: block;
            animation: rotate-icon 3s infinite ease-in-out;
        }

        @@keyframes rotate-icon {
            0%, 100% { transform: rotate(-5deg); }
            50% { transform: rotate(5deg); }
        }

        .role-title {
            font-size: 2em;
            font-weight: 700;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .role-description {
            font-size: 1.1em;
            opacity: 0.9;
            line-height: 1.6;
            position: relative;
            z-index: 1;
        }

        /* Details Screen */
        .details-screen {
            text-align: center;
            animation: slideIn 0.6s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .back-button {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1em;
            font-weight: 600;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .back-button:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateX(-5px);
        }

        .details-title {
            font-size: 3em;
            margin-bottom: 40px;
            text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.4);
        }

        .input-box {
            background: rgba(255, 255, 255, 0.2);
            padding: 40px;
            border-radius: 25px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            margin: 30px 0;
        }

        .input-box input {
            width: 100%;
            padding: 20px 30px;
            border: 3px solid rgba(255, 255, 255, 0.4);
            border-radius: 15px;
            font-size: 1.3em;
            margin: 15px 0;
            background: rgba(255, 255, 255, 0.95);
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .input-box input:focus {
            outline: none;
            border-color: #FFD700;
            transform: scale(1.03);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
        }

        .mode-cards-host {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-top: 40px;
        }

        .mode-card-host {
            background: rgba(255, 255, 255, 0.2);
            padding: 40px 25px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.4s ease;
            backdrop-filter: blur(10px);
            border: 3px solid rgba(255, 255, 255, 0.3);
        }

        .mode-card-host:hover {
            transform: translateY(-10px);
            border-color: #FFD700;
            box-shadow: 0 15px 40px rgba(255, 215, 0, 0.4);
        }

        .mode-card-host .mode-icon {
            font-size: 3.5em;
            margin-bottom: 15px;
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .mode-card-host .mode-title {
            font-size: 1.6em;
            margin-bottom: 10px;
        }

        .btn {
            background: linear-gradient(135deg, #FFD700, #FF69B4);
            border: none;
            color: #000;
            padding: 20px 50px;
            font-size: 1.4em;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 20px 10px;
            box-shadow: 0 8px 30px rgba(255, 215, 0, 0.5);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(255, 105, 180, 0.6);
        }

        .btn:active {
            transform: translateY(-2px);
        }

        @@media (max-width: 768px) {
            h1 {
                font-size: 3em;
            }

            .role-cards {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            .mode-cards-host {
                grid-template-columns: 1fr;
            }

            .role-icon {
                font-size: 4em;
            }

            .role-title {
                font-size: 1.6em;
            }

            .music-note {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Animated music notes background -->
    <div class="music-note">🎵</div>
    <div class="music-note">🎶</div>
    <div class="music-note">🎵</div>
    <div class="music-note">🎶</div>
    <div class="music-note">🎵</div>

    <div class="container">
        <!-- Step 1: Role Selection -->
        <div id="roleSelection" class="role-selection">
            <div class="title-container">
                <h1>🎵 MUSIKQUIZ 🎶</h1>
                <p class="subtitle">Gæt sangens titel!</p>
                <p class="tagline">✨ Den ultimative musikudfordring ✨</p>
            </div>

            <div class="role-cards">
                <div class="role-card" onclick="selectRole('player')">
                    <span class="role-icon">🎤</span>
                    <div class="role-title">Spiller</div>
                    <div class="role-description">Join et spil og buzz ind når du kender sangen!</div>
                </div>
                <div class="role-card" onclick="selectRole('host')">
                    <span class="role-icon">🎮</span>
                    <div class="role-title">Vært</div>
                    <div class="role-description">Opret og styr dit eget musikquiz spil!</div>
                </div>
            </div>
        </div>

        <!-- Step 2: Player Details -->
        <div id="playerDetails" class="details-screen hidden">
            <button class="back-button" onclick="goBack()">⬅️ Tilbage</button>
            <div class="title-container">
                <h2 class="details-title">🎤 Join Spil</h2>
            </div>

            <div class="input-box">
                <input type="text" id="playerName" placeholder="Dit navn" maxlength="20">
                <input type="text" id="gameCode" placeholder="Spil kode">
                <button class="btn" onclick="joinAsPlayer()">🎵 Join!</button>
            </div>
        </div>

        <!-- Step 3: Host Details -->
        <div id="hostDetails" class="details-screen hidden">
            <button class="back-button" onclick="goBack()">⬅️ Tilbage</button>
            <div class="title-container">
                <h2 class="details-title">🎮 Opret Spil</h2>
            </div>

            <div class="input-box">
                <p style="font-size: 1.3em; margin-bottom: 20px;">Vælg spilletilstand:</p>
                <div class="mode-cards-host">
                    <div class="mode-card-host" onclick="createAsHost(false)">
                        <span class="mode-icon">👤</span>
                        <div class="mode-title">Solo</div>
                        <div class="mode-description">Alle spiller individuelt</div>
                    </div>
                    <div class="mode-card-host" onclick="createAsHost(true)">
                        <span class="mode-icon">👥</span>
                        <div class="mode-title">Hold</div>
                        <div class="mode-description">Spil i teams</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Navigation functions
        function selectRole(role) {
            document.getElementById('roleSelection').classList.add('hidden');
            
            if (role === 'player') {
                document.getElementById('playerDetails').classList.remove('hidden');
            } else if (role === 'host') {
                document.getElementById('hostDetails').classList.remove('hidden');
            }
        }

        function goBack() {
            document.getElementById('playerDetails').classList.add('hidden');
            document.getElementById('hostDetails').classList.add('hidden');
            document.getElementById('roleSelection').classList.remove('hidden');
        }

        function joinAsPlayer() {
            const name = document.getElementById('playerName').value.trim();
            const code = document.getElementById('gameCode').value.trim();

            if (!name || !code) {
                alert('Indtast venligst navn og spil kode');
                return;
            }

            localStorage.setItem('playerName', name);
            localStorage.setItem('gameCode', code);
            window.location.href = '/Home/Play';
        }

        function createAsHost(isTeamMode) {
            // Host doesn't need to enter name - we'll use default
            localStorage.setItem('hostName', 'Vært');
            localStorage.setItem('isTeamMode', isTeamMode ? 'true' : 'false');
            window.location.href = '/Home/Host';
        }

        // Make buttons responsive on mobile
        function checkMobile() {
            const buttons = document.querySelectorAll('.btn');
            if (window.innerWidth <= 768) {
                buttons.forEach(btn => {
                    btn.style.width = '100%';
                });
            } else {
                buttons.forEach(btn => {
                    btn.style.width = '250px';
                });
            }
        }

        // Check on load and resize
        window.addEventListener('load', checkMobile);
        window.addEventListener('resize', checkMobile);
    </script>
</body>
</html>