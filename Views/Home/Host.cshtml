@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
    <title>Jeopardy - Vært</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: white;
            min-height: 100vh;
            padding: 20px;
            touch-action: manipulation;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .host-header {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .game-code {
            font-size: 2.5em;
            color: #FFD700;
            font-weight: bold;
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }

        .players-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .players-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .player-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }

        .player-score {
            font-size: 1.5em;
            color: #FFD700;
            font-weight: bold;
        }

        .game-board {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        .category-header {
            background: #FFD700;
            color: #000;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 8px;
            text-transform: uppercase;
        }

        .question-tile {
            background: #000080;
            color: #FFD700;
            padding: 30px;
            text-align: center;
            font-size: 1.8em;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid #FFD700;
        }

            .question-tile:hover {
                background: #0000CD;
                transform: scale(1.05);
            }

            .question-tile.used {
                background: #333;
                color: #666;
                cursor: not-allowed;
                opacity: 0.5;
            }

        .buzz-panel {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-top: 20px;
            backdrop-filter: blur(10px);
        }

        .timer-display {
            background: #ff6b6b;
            color: white;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 1.5em;
            font-weight: bold;
            margin: 10px 0;
            text-align: center;
            transition: background-color 0.3s ease;
        }

            .timer-display.expired {
                background: #666;
            }

            .timer-display.extended {
                background: #ff9500;
            }

        .progress-container {
            width: 100%;
            height: 20px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            margin: 10px 0;
            overflow: hidden;
            position: relative;
            display: none;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(45deg, #4CAF50, #8BC34A);
            width: 0%;
            border-radius: 10px;
            transition: width 1s linear;
            position: relative;
            overflow: hidden;
        }

        .progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shimmer 2s infinite;
        }

        .progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 0.9em;
            font-weight: bold;
            color: white;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
            z-index: 1;
        }

        @@keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .buzz-list {
            margin: 15px 0;
        }

        .buzz-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
            margin: 5px 0;
        }

        .buzz-order {
            background: #FFD700;
            color: #000;
            padding: 8px 12px;
            border-radius: 50%;
            font-weight: bold;
        }

        .btn {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 12px 25px;
            font-size: 1em;
            border-radius: 8px;
            cursor: pointer;
            margin: 5px;
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3);
            }

        .btn-danger {
            background: linear-gradient(45deg, #ff6b6b, #ee5a24);
        }

        .score-controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .score-input {
            width: 80px;
            padding: 5px;
            border-radius: 4px;
            border: none;
            text-align: center;
        }

        .hidden {
            display: none;
        }

        @@media (max-width: 768px) {
            body {
                padding: 10px;
            }

            .game-board {
                grid-template-columns: repeat(2, 1fr);
                gap: 6px;
            }

            .question-tile {
                padding: 15px 8px;
                font-size: 1.2em;
                min-height: 50px;
            }

            .category-header {
                padding: 8px 4px;
                font-size: 0.8em;
            }

            .players-grid {
                grid-template-columns: 1fr;
            }

            .game-code {
                font-size: 2em;
                padding: 10px;
            }

            .host-header, .players-section, .buzz-panel {
                padding: 15px;
                margin-bottom: 15px;
            }

            .player-card {
                padding: 10px;
            }

            .btn {
                padding: 10px 20px;
                font-size: 0.9em;
                margin: 3px;
            }

            .buzz-item {
                padding: 10px;
                font-size: 0.9em;
            }

            .score-controls {
                flex-direction: column;
                gap: 5px;
            }

            .score-input {
                width: 100%;
                margin-bottom: 5px;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 5px;
            }

            .container {
                max-width: 100%;
            }

            .game-board {
                grid-template-columns: repeat(2, 1fr);
                gap: 4px;
            }

            .question-tile {
                padding: 10px 6px;
                font-size: 1em;
                min-height: 45px;
            }

            .category-header {
                padding: 6px 2px;
                font-size: 0.7em;
            }

            .game-code {
                font-size: 1.6em;
                padding: 8px;
            }

            .host-header h1 {
                font-size: 1.5em;
            }

            .players-section h2 {
                font-size: 1.2em;
            }

            .buzz-panel h2 {
                font-size: 1.2em;
            }

            .timer-display {
                font-size: 1.2em;
                padding: 8px 15px;
            }

            .btn {
                padding: 8px 15px;
                font-size: 0.8em;
                margin: 2px;
            }

            .buzz-item {
                padding: 8px;
                font-size: 0.8em;
            }

            .buzz-order {
                padding: 6px 10px;
            }

            .player-score {
                font-size: 1.2em;
            }
        }

        @@media (max-width: 896px) and (orientation: landscape) {
            .game-board {
                grid-template-columns: repeat(5, 1fr);
                gap: 3px;
            }

            .question-tile {
                padding: 8px 4px;
                font-size: 0.9em;
                min-height: 40px;
            }

            .category-header {
                padding: 4px 2px;
                font-size: 0.6em;
            }

            .players-grid {
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="host-header">
            <h1>🎮 Jeopardy Vært</h1>
            <div class="game-code">Spil Kode: <span id="gameCodeDisplay">----</span></div>
            <button class="btn btn-danger" onclick="endGame()">Afslut Spil</button>
        </div>

        <div class="players-section">
            <h2>Spillere (<span id="playerCount">0</span>)</h2>
            <div id="playersGrid" class="players-grid"></div>
        </div>

        <div id="gameBoard" class="game-board"></div>

        <div id="buzzPanel" class="buzz-panel hidden">
            <h2>Spillere der buzzede:</h2>
            <div id="timerDisplay" class="timer-display">10</div>
            <div id="progressContainer" class="progress-container">
                <div id="progressBar" class="progress-bar"></div>
                <div id="progressText" class="progress-text">Extra tid: 20</div>
            </div>
            <div id="buzzList" class="buzz-list"></div>
            <button class="btn" onclick="resetBuzz()">Nulstil Buzzer</button>
            <button class="btn" onclick="backToBoard()">Tilbage til Brættet</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/gameHub")
            .build();

        let gameData = {
            gameCode: '',
            board: null,
            players: {},
            buzzTimer: null,
            timeLeft: 10
        };

        // Start connection
        connection.start().then(function () {
            const hostName = localStorage.getItem('hostName') || 'Vært';
            connection.invoke("CreateGame", hostName);
        }).catch(function (err) {
            console.error('Connection error:', err);
            alert('Kunne ikke oprette forbindelse til serveren');
        });

        // Event handlers
        connection.on("GameCreated", function (data) {
            gameData.gameCode = data.gameCode;
            gameData.board = data.board;
            document.getElementById('gameCodeDisplay').textContent = data.gameCode;
            renderBoard();
        });

        connection.on("PlayersUpdated", function (players) {
            gameData.players = {};
            players.forEach(p => gameData.players[p.id] = p);
            updatePlayersDisplay();
        });

        connection.on("BuzzReceived", function (data) {
            // Start timer only when first buzz is received
            if (data.buzzes.length === 1) {
                startBuzzTimer();
            }
            showBuzzPanel(data.buzzes);
        });

        connection.on("BuzzCleared", function () {
            stopBuzzTimer();
            document.getElementById('buzzPanel').classList.add('hidden');
            document.getElementById('gameBoard').classList.remove('hidden');
        });

        connection.on("BuzzTimeExpired", function () {
            // Don't stop timer here anymore - extended timer will start
            const timerDisplay = document.getElementById('timerDisplay');
            timerDisplay.textContent = "Første periode udløbet - starter extra tid...";
            timerDisplay.classList.add('expired');
        });

        // New event handler for extended 20-second timer
        connection.on("ExtendedBuzzTimerStarted", function () {
            startExtendedBuzzTimer();
        });

        connection.on("ExtendedBuzzTimeExpired", function () {
            stopBuzzTimer();
            // Hide progress bar and show timer with final message
            const timerDisplay = document.getElementById('timerDisplay');
            const progressContainer = document.getElementById('progressContainer');
            
            progressContainer.style.display = 'none';
            timerDisplay.style.display = 'block';
            timerDisplay.textContent = "Alle tider udløbet!";
            timerDisplay.classList.add('expired');
            timerDisplay.style.background = '#666';
        });

        function renderBoard() {
            const board = document.getElementById('gameBoard');
            board.innerHTML = '';

            // Add category headers
            gameData.board.categories.forEach(category => {
                const header = document.createElement('div');
                header.className = 'category-header';
                header.textContent = category.name;
                board.appendChild(header);
            });

            // Add question tiles
            for (let i = 0; i < 5; i++) {
                gameData.board.categories.forEach((category, catIndex) => {
                    const tile = document.createElement('div');
                    const question = category.questions[i];
                    tile.className = `question-tile ${question.isUsed ? 'used' : ''}`;
                    tile.textContent = question.value;

                    if (!question.isUsed) {
                        tile.onclick = () => selectQuestion(catIndex, i);
                    }

                    board.appendChild(tile);
                });
            }
        }

        function selectQuestion(categoryIndex, questionIndex) {
            // Fortæl serveren at et spørgsmål er valgt
            connection.invoke("SelectQuestion", categoryIndex, questionIndex);

            // Vis buzz-panelet og skjul brættet med det samme
            document.getElementById('gameBoard').classList.add('hidden');
            document.getElementById('buzzPanel').classList.remove('hidden');
            
            // Show waiting state and hide progress bar
            const timerDisplay = document.getElementById('timerDisplay');
            const buzzList = document.getElementById('buzzList');
            const progressContainer = document.getElementById('progressContainer');
            
            timerDisplay.style.display = 'block';
            timerDisplay.textContent = "Venter på buzz...";
            timerDisplay.classList.remove('expired');
            timerDisplay.style.background = '#ff6b6b';
            
            progressContainer.style.display = 'none';
            buzzList.innerHTML = '';
        }

        function startBuzzTimer() {
            // Stop evt. tidligere timer
            stopBuzzTimer();

            gameData.timeLeft = 10;
            const timerDisplay = document.getElementById('timerDisplay');
            timerDisplay.classList.remove('expired');
            timerDisplay.textContent = gameData.timeLeft; // vis første tal

            gameData.buzzTimer = setInterval(() => {
                gameData.timeLeft--;
                timerDisplay.textContent = gameData.timeLeft;

                if (gameData.timeLeft < 0) {
                    clearInterval(gameData.buzzTimer);
                    gameData.buzzTimer = null;
                    timerDisplay.textContent = "Tid udløbet!";
                    timerDisplay.classList.add('expired');
                }
            }, 1000);
        }

        function stopBuzzTimer() {
            if (gameData.buzzTimer) {
                clearInterval(gameData.buzzTimer);
                gameData.buzzTimer = null;
            }
        }

        function startExtendedBuzzTimer() {
            // Stop any existing timer
            stopBuzzTimer();

            gameData.timeLeft = 20;
            const timerDisplay = document.getElementById('timerDisplay');
            const progressContainer = document.getElementById('progressContainer');
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            
            // Hide regular timer and show progress bar
            timerDisplay.style.display = 'none';
            progressContainer.style.display = 'block';
            
            // Reset progress bar
            progressBar.style.width = '0%';
            progressText.textContent = `Extra tid: ${gameData.timeLeft}`;

            gameData.buzzTimer = setInterval(() => {
                gameData.timeLeft--;
                progressText.textContent = `Extra tid: ${gameData.timeLeft}`;
                
                // Calculate progress percentage (0% at start, 100% at end)
                const progressPercent = ((20 - gameData.timeLeft) / 20) * 100;
                progressBar.style.width = progressPercent + '%';
                
                // Change color as time runs out
                if (gameData.timeLeft <= 5) {
                    progressBar.style.background = 'linear-gradient(45deg, #ff9500, #ff6b6b)';
                } else if (gameData.timeLeft <= 10) {
                    progressBar.style.background = 'linear-gradient(45deg, #FFD700, #ff9500)';
                } else {
                    progressBar.style.background = 'linear-gradient(45deg, #4CAF50, #8BC34A)';
                }

                if (gameData.timeLeft < 0) {
                    clearInterval(gameData.buzzTimer);
                    gameData.buzzTimer = null;
                    
                    // Hide progress bar and show timer with final message
                    progressContainer.style.display = 'none';
                    timerDisplay.style.display = 'block';
                    timerDisplay.textContent = "Alle tider udløbet!";
                    timerDisplay.classList.add('expired');
                    timerDisplay.style.background = '#666';
                }
            }, 1000);
        }

        function updatePlayersDisplay() {
            const grid = document.getElementById('playersGrid');
            const count = document.getElementById('playerCount');

            const playerList = Object.values(gameData.players);
            count.textContent = playerList.length;

            grid.innerHTML = '';
            playerList.forEach(player => {
                const card = document.createElement('div');
                card.className = 'player-card';
                card.innerHTML = `
                    <h3>${player.name}</h3>
                    <div class="player-score">${player.score} point</div>
                    <div class="score-controls">
                        <input type="number" class="score-input" id="score-${player.id}" placeholder="Point">
                        <button class="btn" onclick="updateScore('${player.id}', true)">+</button>
                        <button class="btn btn-danger" onclick="updateScore('${player.id}', false)">-</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function updateScore(playerId, isPositive) {
            const input = document.getElementById(`score-${playerId}`);
            const points = parseInt(input.value) || 0;
            if (points === 0) return;

            const finalPoints = isPositive ? points : -points;
            connection.invoke("UpdateScore", playerId, finalPoints);
            input.value = '';
        }

        function showBuzzPanel(buzzes) {
            document.getElementById('gameBoard').classList.add('hidden');
            document.getElementById('buzzPanel').classList.remove('hidden');

            const timerDisplay = document.getElementById('timerDisplay');
            const buzzList = document.getElementById('buzzList');
            
            // If no buzzes yet, show waiting state
            if (buzzes.length === 0) {
                timerDisplay.textContent = "Venter på buzz...";
                timerDisplay.classList.remove('expired');
            }
            
            buzzList.innerHTML = '';

            buzzes.forEach(buzz => {
                const item = document.createElement('div');
                item.className = 'buzz-item';
                item.innerHTML = `
                    <span>${buzz.playerName}</span>
                    <span class="buzz-order">${buzz.order}</span>
                `;
                buzzList.appendChild(item);
            });
        }

        function resetBuzz() {
            stopBuzzTimer();
            // Hide progress bar and reset timer display
            document.getElementById('progressContainer').style.display = 'none';
            document.getElementById('timerDisplay').style.display = 'block';
            connection.invoke("ResetBuzz");
        }

        function backToBoard() {
            stopBuzzTimer();
            document.getElementById('buzzPanel').classList.add('hidden');
            document.getElementById('gameBoard').classList.remove('hidden');
            
            // Reset timer display style and hide progress bar
            const timerDisplay = document.getElementById('timerDisplay');
            const progressContainer = document.getElementById('progressContainer');
            timerDisplay.style.background = '#ff6b6b';
            timerDisplay.style.display = 'block';
            progressContainer.style.display = 'none';
            
            // Notify players to return to board view
            connection.invoke("HostReturnToBoard");
        }

        function endGame() {
            if (confirm('Er du sikker på, at du vil afslutte spillet?')) {
                window.location.href = '/';
            }
        }

        // Update board when questions are used
        connection.on("QuestionSelected", function (data) {
            gameData.board = data.board;
            renderBoard();
        });

        connection.on("ScoreUpdated", function (data) {
            gameData.players[data.playerId] = {
                id: data.playerId,
                name: data.playerName,
                score: data.newScore
            };
            updatePlayersDisplay();
        });

        // Prevent zoom on double-tap on iOS
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            const now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false);
    </script>
</body>
</html>