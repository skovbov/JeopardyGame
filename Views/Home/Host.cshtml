﻿@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
    <title>Jeopardy - Vært</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: white;
            min-height: 100vh;
            padding: 20px;
            touch-action: manipulation;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .host-header {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .game-code {
            font-size: 2.5em;
            color: #FFD700;
            font-weight: bold;
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }

        .players-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .players-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .player-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }

        .player-score {
            font-size: 1.5em;
            color: #FFD700;
            font-weight: bold;
        }

        .game-board {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        .category-header {
            background: #FFD700;
            color: #000;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 8px;
            text-transform: uppercase;
        }

        .question-tile {
            background: #000080;
            color: #FFD700;
            padding: 30px;
            text-align: center;
            font-size: 1.8em;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid #FFD700;
        }

            .question-tile:hover {
                background: #0000CD;
                transform: scale(1.05);
            }

            .question-tile.used {
                background: #333;
                color: #666;
                cursor: not-allowed;
                opacity: 0.5;
            }

        .buzz-panel {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-top: 20px;
            backdrop-filter: blur(10px);
        }

        /* Simple Countdown Timer */
        .countdown-timer {
            background: rgba(255, 107, 107, 0.2);
            padding: 20px;
            border-radius: 15px;
            margin: 15px 0;
            text-align: center;
            border: 3px solid #ff6b6b;
        }

        .countdown-display {
            font-size: 4em;
            font-weight: bold;
            color: #ff6b6b;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            margin: 10px 0;
        }

        .countdown-display.warning {
            color: #ff9500;
            animation: pulse 0.5s infinite;
        }

        .countdown-display.critical {
            color: #ff0000;
            animation: pulse 0.3s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .buzz-list {
            margin: 15px 0;
        }

        .buzz-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
            margin: 5px 0;
        }

        .buzz-order {
            background: #FFD700;
            color: #000;
            padding: 8px 12px;
            border-radius: 50%;
            font-weight: bold;
        }

        .btn {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 12px 25px;
            font-size: 1em;
            border-radius: 8px;
            cursor: pointer;
            margin: 5px;
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(0, 0, 0, 0.3);
            }

        .btn-danger {
            background: linear-gradient(45deg, #ff6b6b, #ee5a24);
        }

        .score-controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .score-input {
            width: 80px;
            padding: 5px;
            border-radius: 4px;
            border: none;
            text-align: center;
        }

        .hidden {
            display: none;
        }

        /* Team Mode Styles */
        .team-lobby {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .team-creation {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .team-input-group {
            display: flex;
            gap: 10px;
            margin: 10px 0;
            flex-wrap: wrap;
        }

        .team-input-group input {
            flex: 1;
            min-width: 150px;
            padding: 10px;
            border-radius: 8px;
            border: none;
            font-size: 1em;
        }

        .teams-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .team-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            border-left: 5px solid;
        }

        .team-members {
            margin-top: 10px;
            font-size: 0.9em;
        }

        .team-member {
            background: rgba(255, 255, 255, 0.1);
            padding: 5px 10px;
            border-radius: 5px;
            margin: 5px 0;
        }

        .waiting-players {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
        }

        .waiting-player {
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 12px;
            border-radius: 5px;
            margin: 5px 0;
            display: inline-block;
            margin-right: 10px;
        }

        /* Music Controls */
        .music-controls {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            text-align: center;
        }

        .music-controls button {
            margin: 5px;
        }

        .answer-display {
            background: rgba(255, 215, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
            font-size: 1.5em;
            font-weight: bold;
            border: 2px solid #FFD700;
            text-align: center;
        }

        .btn-music {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

        .btn-answer {
            background: linear-gradient(45deg, #FFD700, #FFA500);
            color: #000;
        }

        @@media (max-width: 768px) {
            body {
                padding: 10px;
            }

            .game-board {
                grid-template-columns: repeat(2, 1fr);
                gap: 6px;
            }

            .question-tile {
                padding: 15px 8px;
                font-size: 1.2em;
                min-height: 50px;
            }

            .category-header {
                padding: 8px 4px;
                font-size: 0.8em;
            }

            .players-grid {
                grid-template-columns: 1fr;
            }

            .game-code {
                font-size: 2em;
                padding: 10px;
            }

            .host-header, .players-section, .buzz-panel {
                padding: 15px;
                margin-bottom: 15px;
            }

            .player-card {
                padding: 10px;
            }

            .btn {
                padding: 10px 20px;
                font-size: 0.9em;
                margin: 3px;
            }

            .buzz-item {
                padding: 10px;
                font-size: 0.9em;
            }

            .score-controls {
                flex-direction: column;
                gap: 5px;
            }

            .score-input {
                width: 100%;
                margin-bottom: 5px;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 5px;
            }

            .container {
                max-width: 100%;
            }

            .game-board {
                grid-template-columns: repeat(2, 1fr);
                gap: 4px;
            }

            .question-tile {
                padding: 10px 6px;
                font-size: 1em;
                min-height: 45px;
            }

            .category-header {
                padding: 6px 2px;
                font-size: 0.7em;
            }

            .game-code {
                font-size: 1.6em;
                padding: 8px;
            }

            .host-header h1 {
                font-size: 1.5em;
            }

            .players-section h2 {
                font-size: 1.2em;
            }

            .buzz-panel h2 {
                font-size: 1.2em;
            }

            .timer-display {
                font-size: 1.2em;
                padding: 8px 15px;
            }

            .btn {
                padding: 8px 15px;
                font-size: 0.8em;
                margin: 2px;
            }

            .buzz-item {
                padding: 8px;
                font-size: 0.8em;
            }

            .buzz-order {
                padding: 6px 10px;
            }

            .player-score {
                font-size: 1.2em;
            }
        }

        @@media (max-width: 896px) and (orientation: landscape) {
            .game-board {
                grid-template-columns: repeat(5, 1fr);
                gap: 3px;
            }

            .question-tile {
                padding: 8px 4px;
                font-size: 0.9em;
                min-height: 40px;
            }

            .category-header {
                padding: 4px 2px;
                font-size: 0.6em;
            }

            .players-grid {
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="host-header">
            <h1>🎮 Jeopardy Vært</h1>
            <div class="game-code">Spil Kode: <span id="gameCodeDisplay">----</span></div>
            <button class="btn btn-danger" onclick="endGame()">Afslut Spil</button>
        </div>

        <!-- Team Lobby (shown only in team mode before game starts) -->
        <div id="teamLobby" class="team-lobby hidden">
            <h2>Hold Opsætning</h2>
            <div class="team-creation">
                <h3>Opret Hold</h3>
                <div class="team-input-group">
                    <input type="text" id="teamName" placeholder="Hold navn" maxlength="30">
                    <input type="color" id="teamColor" value="#667eea">
                    <button class="btn" onclick="createTeam()">Opret Hold</button>
                </div>
            </div>
            <div id="teamsGrid" class="teams-grid"></div>
            <div class="waiting-players">
                <h3>Ventende Spillere</h3>
                <div id="waitingPlayers">Ingen spillere venter endnu...</div>
            </div>
            <button class="btn" onclick="startGame()" style="background: linear-gradient(45deg, #4CAF50, #8BC34A); width: 100%; margin-top: 20px; font-size: 1.2em;">Start Spil</button>
        </div>

        <div class="players-section" id="playersSection">
            <h2>Spillere (<span id="playerCount">0</span>)</h2>
            <div id="playersGrid" class="players-grid"></div>
        </div>

        <div id="gameBoard" class="game-board"></div>

        <div id="buzzPanel" class="buzz-panel hidden">
            <h2>Spillere der buzzede:</h2>
            
            <!-- Music Controls -->
            <div id="musicControls" class="music-controls hidden">
                <h3>🎵 Musik Kontrol</h3>
                <button class="btn btn-music" onclick="startMusicManually()">▶️ Start Musik</button>
                <button class="btn btn-music" onclick="stopMusicManually()">⏹️ Stop Musik</button>
                <button class="btn btn-answer" onclick="revealAnswer()">💡 Vis Svar</button>
                <div id="answerDisplay" class="answer-display hidden"></div>
            </div>
            
            <!-- Simple countdown timer -->
            <div id="countdownTimer" class="countdown-timer hidden">
                <h2>⏱️ Timer</h2>
                <div id="countdownDisplay" class="countdown-display">10</div>
            </div>
            
            <div id="buzzList" class="buzz-list"></div>
            <button class="btn" onclick="resetBuzz()">Nulstil Buzzer</button>
            <button class="btn" onclick="backToBoard()">Tilbage til Brættet</button>
        </div>
        
        <!-- Hidden audio player -->
        <audio id="musicPlayer" style="display: none;"></audio>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/gameHub")
            .build();

        let gameData = {
            gameCode: '',
            board: null,
            players: {},
            teams: {},
            isTeamMode: false,
            isGameStarted: false,
            countdownTimer: null,
            timeLeft: 10,
            currentMusicFile: null,
            currentAnswer: null,
            musicPlayer: null
        };

        // Initialize music player
        gameData.musicPlayer = document.getElementById('musicPlayer');

        // Start connection
        connection.start().then(function () {
            const hostName = localStorage.getItem('hostName') || 'Vært';
            const isTeamMode = localStorage.getItem('isTeamMode') === 'true';
            connection.invoke("CreateGame", hostName, isTeamMode);
        }).catch(function (err) {
            console.error('Connection error:', err);
            alert('Kunne ikke oprette forbindelse til serveren');
        });

        // Event handlers
        connection.on("GameCreated", function (data) {
            gameData.gameCode = data.gameCode;
            gameData.board = data.board;
            gameData.isTeamMode = data.isTeamMode;
            document.getElementById('gameCodeDisplay').textContent = data.gameCode;
            
            if (gameData.isTeamMode) {
                // Show team lobby, hide game board and players section
                document.getElementById('teamLobby').classList.remove('hidden');
                document.getElementById('gameBoard').classList.add('hidden');
                document.getElementById('playersSection').classList.add('hidden');
            } else {
                // Show game board and players section normally
                document.getElementById('teamLobby').classList.add('hidden');
                document.getElementById('playersSection').classList.remove('hidden');
                renderBoard();
            }
        });

        connection.on("PlayersUpdated", function (players) {
            gameData.players = {};
            players.forEach(p => gameData.players[p.id] = p);
            
            if (gameData.isTeamMode && !gameData.isGameStarted) {
                updateTeamLobby();
            } else {
                updatePlayersDisplay();
            }
        });

        connection.on("BuzzReceived", function (data) {
            // Start simple countdown timer when team/player buzzes
            startCountdown();
            showBuzzPanel(data.buzzes);
        });

        connection.on("BuzzCleared", function () {
            stopBuzzTimer();
            document.getElementById('buzzPanel').classList.add('hidden');
            document.getElementById('gameBoard').classList.remove('hidden');
        });

        connection.on("ExtendedBuzzTimeExpired", function () {
            stopBuzzTimer();
            // Hide progress bar and show timer with final message
            const timerDisplay = document.getElementById('timerDisplay');
            const progressContainer = document.getElementById('progressContainer');
            
            progressContainer.style.display = 'none';
            timerDisplay.style.display = 'block';
            timerDisplay.textContent = "I didnt get it";
            timerDisplay.classList.add('expired');
            timerDisplay.style.background = '#666';
        });

        // Removed complex timer event handlers - using simple countdown now

        // Music event handlers
        connection.on("PlayMusic", function (data) {
            gameData.currentMusicFile = data.musicFile;
            gameData.currentAnswer = data.answer;
            
            if (gameData.musicPlayer && data.musicFile) {
                gameData.musicPlayer.src = data.musicFile;
                gameData.musicPlayer.loop = true;
                gameData.musicPlayer.play().catch(err => console.error('Music play error:', err));
                
                // Show music controls
                document.getElementById('musicControls').classList.remove('hidden');
                document.getElementById('answerDisplay').classList.add('hidden');
            }
        });

        // Music is now controlled manually by host - no automatic stop/resume

        function renderBoard() {
            const board = document.getElementById('gameBoard');
            board.innerHTML = '';

            // Add category headers
            gameData.board.categories.forEach(category => {
                const header = document.createElement('div');
                header.className = 'category-header';
                header.textContent = category.name;
                board.appendChild(header);
            });

            // Add question tiles
            for (let i = 0; i < 5; i++) {
                gameData.board.categories.forEach((category, catIndex) => {
                    const tile = document.createElement('div');
                    const question = category.questions[i];
                    tile.className = `question-tile ${question.isUsed ? 'used' : ''}`;
                    tile.textContent = question.value;

                    if (!question.isUsed) {
                        tile.onclick = () => selectQuestion(catIndex, i);
                    }

                    board.appendChild(tile);
                });
            }
        }

        function selectQuestion(categoryIndex, questionIndex) {
            // Fortæl serveren at et spørgsmål er valgt
            connection.invoke("SelectQuestion", categoryIndex, questionIndex);

            // Vis buzz-panelet og skjul brættet med det samme
            document.getElementById('gameBoard').classList.add('hidden');
            document.getElementById('buzzPanel').classList.remove('hidden');
            
            // Hide countdown timer initially
            document.getElementById('countdownTimer').classList.add('hidden');
            document.getElementById('buzzList').innerHTML = '';
        }

        // Old complex timer functions removed - using simple countdown now

        function updatePlayersDisplay() {
            const grid = document.getElementById('playersGrid');
            const count = document.getElementById('playerCount');

            const playerList = Object.values(gameData.players);
            count.textContent = playerList.length;

            grid.innerHTML = '';
            playerList.forEach(player => {
                const card = document.createElement('div');
                card.className = 'player-card';
                card.innerHTML = `
                    <h3>${player.name}</h3>
                    <div class="player-score">${player.score} point</div>
                    <div class="score-controls">
                        <input type="number" class="score-input" id="score-${player.id}" placeholder="Point">
                        <button class="btn" onclick="updateScore('${player.id}', true)">+</button>
                        <button class="btn btn-danger" onclick="updateScore('${player.id}', false)">-</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function updateScore(playerId, isPositive) {
            const input = document.getElementById(`score-${playerId}`);
            const points = parseInt(input.value) || 0;
            if (points === 0) return;

            const finalPoints = isPositive ? points : -points;
            connection.invoke("UpdateScore", playerId, finalPoints);
            input.value = '';
        }

        function showBuzzPanel(buzzes) {
            document.getElementById('gameBoard').classList.add('hidden');
            document.getElementById('buzzPanel').classList.remove('hidden');

            const timerDisplay = document.getElementById('timerDisplay');
            const buzzList = document.getElementById('buzzList');
            
            // If no buzzes yet, show waiting state
            if (buzzes.length === 0) {
                timerDisplay.textContent = "Venter på buzz...";
                timerDisplay.classList.remove('expired');
            }
            
            buzzList.innerHTML = '';

            buzzes.forEach(buzz => {
                const item = document.createElement('div');
                item.className = 'buzz-item';
                item.innerHTML = `
                    <span>${buzz.playerName}</span>
                    <span class="buzz-order">${buzz.order}</span>
                `;
                buzzList.appendChild(item);
            });
        }

        function resetBuzz() {
            stopCountdown();
            // Stop music
            if (gameData.musicPlayer) {
                gameData.musicPlayer.pause();
                gameData.musicPlayer.currentTime = 0;
            }
            // Hide music controls and countdown
            document.getElementById('musicControls').classList.add('hidden');
            document.getElementById('answerDisplay').classList.add('hidden');
            document.getElementById('countdownTimer').classList.add('hidden');
            gameData.currentMusicFile = null;
            gameData.currentAnswer = null;
            
            connection.invoke("ResetBuzz");
        }

        function backToBoard() {
            stopCountdown();
            
            // Stop music
            if (gameData.musicPlayer) {
                gameData.musicPlayer.pause();
                gameData.musicPlayer.currentTime = 0;
            }
            // Hide music controls and countdown
            document.getElementById('musicControls').classList.add('hidden');
            document.getElementById('answerDisplay').classList.add('hidden');
            document.getElementById('countdownTimer').classList.add('hidden');
            gameData.currentMusicFile = null;
            gameData.currentAnswer = null;
            
            document.getElementById('buzzPanel').classList.add('hidden');
            document.getElementById('gameBoard').classList.remove('hidden');
            
            // Notify players to return to board view
            connection.invoke("HostReturnToBoard");
        }

        function endGame() {
            if (confirm('Er du sikker på, at du vil afslutte spillet?')) {
                window.location.href = '/';
            }
        }

        // Update board when questions are used
        connection.on("QuestionSelected", function (data) {
            gameData.board = data.board;
            renderBoard();
        });

        connection.on("ScoreUpdated", function (data) {
            if (gameData.isTeamMode && data.teams) {
                // Update teams and players
                gameData.teams = {};
                data.teams.forEach(t => gameData.teams[t.id] = t);
                gameData.players = {};
                data.players.forEach(p => gameData.players[p.id] = p);
                updateTeamPlayersDisplay();
            } else {
                // Solo mode
                gameData.players[data.playerId] = {
                    id: data.playerId,
                    name: data.playerName,
                    score: data.newScore
                };
                updatePlayersDisplay();
            }
        });

        // Music control functions
        function startMusicManually() {
            if (gameData.musicPlayer && gameData.currentMusicFile) {
                gameData.musicPlayer.play().catch(err => console.error('Music play error:', err));
            }
        }

        function stopMusicManually() {
            if (gameData.musicPlayer) {
                gameData.musicPlayer.pause();
            }
        }

        function revealAnswer() {
            const answerDisplay = document.getElementById('answerDisplay');
            if (gameData.currentAnswer) {
                answerDisplay.textContent = `🎵 Svar: ${gameData.currentAnswer}`;
                answerDisplay.classList.remove('hidden');
            } else {
                answerDisplay.textContent = '🎵 Ingen svar tilgængeligt';
                answerDisplay.classList.remove('hidden');
            }
        }

        // Simple countdown timer functions
        function startCountdown() {
            // Stop music when countdown starts
            if (gameData.musicPlayer) {
                gameData.musicPlayer.pause();
            }

            // Stop any existing countdown
            stopCountdown();

            // Show countdown timer
            document.getElementById('countdownTimer').classList.remove('hidden');
            
            // Reset to 10 seconds
            gameData.timeLeft = 10;
            const countdownDisplay = document.getElementById('countdownDisplay');
            countdownDisplay.textContent = gameData.timeLeft;
            countdownDisplay.classList.remove('warning', 'critical');

            // Start countdown
            gameData.countdownTimer = setInterval(() => {
                gameData.timeLeft--;
                countdownDisplay.textContent = gameData.timeLeft;

                // Visual warnings
                if (gameData.timeLeft <= 3) {
                    countdownDisplay.classList.add('critical');
                    countdownDisplay.classList.remove('warning');
                } else if (gameData.timeLeft <= 5) {
                    countdownDisplay.classList.add('warning');
                    countdownDisplay.classList.remove('critical');
                }

                // Stop at 0
                if (gameData.timeLeft <= 0) {
                    stopCountdown();
                    countdownDisplay.textContent = "STOP!";
                }
            }, 1000);
        }

        function stopCountdown() {
            if (gameData.countdownTimer) {
                clearInterval(gameData.countdownTimer);
                gameData.countdownTimer = null;
            }
        }

        // Team mode event handlers
        connection.on("TeamCreated", function (data) {
            gameData.teams = {};
            data.teams.forEach(t => gameData.teams[t.id] = t);
            updateTeamLobby();
        });

        connection.on("TeamsUpdated", function (data) {
            gameData.teams = {};
            data.teams.forEach(t => gameData.teams[t.id] = t);
            gameData.players = {};
            data.players.forEach(p => gameData.players[p.id] = p);
            updateTeamLobby();
        });

        connection.on("GameStarted", function (data) {
            gameData.isGameStarted = true;
            gameData.board = data.board;
            gameData.teams = {};
            data.teams.forEach(t => gameData.teams[t.id] = t);
            gameData.players = {};
            data.players.forEach(p => gameData.players[p.id] = p);
            
            // Hide team lobby, show game board and team display
            document.getElementById('teamLobby').classList.add('hidden');
            document.getElementById('gameBoard').classList.remove('hidden');
            document.getElementById('playersSection').classList.remove('hidden');
            
            renderBoard();
            updateTeamPlayersDisplay();
        });

        // Team management functions
        function createTeam() {
            const teamNameInput = document.getElementById('teamName');
            const teamColorInput = document.getElementById('teamColor');
            const teamName = teamNameInput.value.trim();
            const teamColor = teamColorInput.value;

            if (!teamName) {
                alert('Indtast venligst et holdnavn');
                return;
            }

            connection.invoke("CreateTeam", teamName, teamColor);
            teamNameInput.value = '';
        }

        function startGame() {
            if (Object.keys(gameData.teams).length === 0) {
                alert('Opret mindst ét hold før du starter spillet');
                return;
            }

            const teamsWithPlayers = Object.values(gameData.teams).filter(t => t.playerIds.length > 0);
            if (teamsWithPlayers.length === 0) {
                alert('Mindst ét hold skal have spillere før du starter spillet');
                return;
            }

            connection.invoke("StartGame");
        }

        function updateTeamLobby() {
            // Update teams grid
            const teamsGrid = document.getElementById('teamsGrid');
            teamsGrid.innerHTML = '';

            Object.values(gameData.teams).forEach(team => {
                const teamCard = document.createElement('div');
                teamCard.className = 'team-card';
                teamCard.style.borderLeftColor = team.color;
                
                const teamPlayers = Object.values(gameData.players).filter(p => p.teamId === team.id);
                
                teamCard.innerHTML = `
                    <h3 style="color: ${team.color}">${team.name}</h3>
                    <div class="team-members">
                        ${teamPlayers.length === 0 ? '<em>Ingen spillere endnu</em>' : ''}
                        ${teamPlayers.map(p => `<div class="team-member">${p.name}</div>`).join('')}
                    </div>
                `;
                teamsGrid.appendChild(teamCard);
            });

            // Update waiting players
            const waitingPlayersDiv = document.getElementById('waitingPlayers');
            const waitingPlayers = Object.values(gameData.players).filter(p => !p.teamId);
            
            if (waitingPlayers.length === 0) {
                waitingPlayersDiv.innerHTML = 'Ingen spillere venter endnu...';
            } else {
                waitingPlayersDiv.innerHTML = waitingPlayers.map(p => 
                    `<span class="waiting-player">${p.name}</span>`
                ).join('');
            }
        }

        function updateTeamPlayersDisplay() {
            const grid = document.getElementById('playersGrid');
            const count = document.getElementById('playerCount');

            // Group by teams
            const teamsList = Object.values(gameData.teams);
            count.textContent = `${Object.keys(gameData.players).length} spillere i ${teamsList.length} hold`;

            grid.innerHTML = '';
            teamsList.forEach(team => {
                const card = document.createElement('div');
                card.className = 'player-card';
                card.style.borderLeft = `5px solid ${team.color}`;
                
                const teamPlayers = Object.values(gameData.players).filter(p => p.teamId === team.id);
                const playerNames = teamPlayers.map(p => p.name).join(', ');
                
                card.innerHTML = `
                    <h3 style="color: ${team.color}">${team.name}</h3>
                    <div style="font-size: 0.9em; margin: 5px 0;">${playerNames}</div>
                    <div class="player-score">${team.score} point</div>
                    <div class="score-controls">
                        <input type="number" class="score-input" id="score-team-${team.id}" placeholder="Point">
                        <button class="btn" onclick="updateTeamScore('${team.id}', true)">+</button>
                        <button class="btn btn-danger" onclick="updateTeamScore('${team.id}', false)">-</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function updateTeamScore(teamId, isPositive) {
            // Find first player in team to use as reference for score update
            const team = gameData.teams[teamId];
            if (!team || !team.playerIds || team.playerIds.length === 0) return;
            
            const firstPlayerId = team.playerIds[0];
            const input = document.getElementById(`score-team-${teamId}`);
            const points = parseInt(input.value) || 0;
            if (points === 0) return;

            const finalPoints = isPositive ? points : -points;
            connection.invoke("UpdateScore", firstPlayerId, finalPoints);
            input.value = '';
        }

        // Prevent zoom on double-tap on iOS
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function (event) {
            const now = (new Date()).getTime();
            if (now - lastTouchEnd <= 300) {
                event.preventDefault();
            }
            lastTouchEnd = now;
        }, false);
    </script>
</body>
</html>